      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="w0" value="&lt;b&gt;01 · MI RESUMEN&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;white-space:pre-wrap&quot;&gt;Resumen del hogar&#10;┌─────────────────────────────┐&#10;│ Consumo │ Costo │ Presupuesto│&#10;├─────────────────────────────┤&#10;│ Gráfico + ver cifras        │&#10;├─────────────────────────────┤&#10;│ Accesos a tareas frecuentes│&#10;└─────────────────────────────┘&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FCFB;strokeColor=#168B82;fontColor=#243746;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="45" width="700" height="185" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="&lt;b&gt;02 · EQUIPOS ELÉCTRICOS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;white-space:pre-wrap&quot;&gt;Inventario&#10;[＋ Añadir equipo] [Buscar…]&#10;┌─────────────────────────────┐&#10;│ Equipo | Uso | Estado       │&#10;│ Editar · Simular · Eliminar │&#10;└─────────────────────────────┘&#10;Formulario: potencia o kWh/mes&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FCFB;strokeColor=#168B82;fontColor=#243746;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="810" y="45" width="700" height="185" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="&lt;b&gt;03 · LECTURAS Y FACTURAS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;white-space:pre-wrap&quot;&gt;Comparar periodos + registrar&#10;┌──────────────┬──────────────┐&#10;│ Periodo A/B  │ Nueva factura│&#10;│ kWh y costo  │ fechas, kWh  │&#10;├──────────────┴──────────────┤&#10;│ Historial y tendencia       │&#10;└─────────────────────────────┘&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FCFB;strokeColor=#168B82;fontColor=#243746;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="275" width="700" height="185" as="geometry" />

        <mxCell id="w3" value="&lt;b&gt;04 · SIMULADOR DE AHORRO&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;white-space:pre-wrap&quot;&gt;Elegir equipo y ajustar horas/días&#10;┌──────────────┬──────────────┐&#10;│ Antes        │ Después      │&#10;│ consumo/costo│ consumo/costo│&#10;└──────────────┴──────────────┘&#10;Añadir cambio → revisar plan&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FCFB;strokeColor=#168B82;fontColor=#243746;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="810" y="275" width="700" height="185" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="&lt;b&gt;05 · PRESUPUESTO ANUAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;white-space:pre-wrap&quot;&gt;Meta de reducción · límite de gasto&#10;┌──────────────┬──────────────┐&#10;│ Costo actual │ Con propuesta│&#10;├──────────────┴──────────────┤&#10;│ Horarios sugeridos por equipo│&#10;└─────────────────────────────┘&#10;Revisar y confirmar aplicación&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FCFB;strokeColor=#168B82;fontColor=#243746;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="505" width="700" height="185" as="geometry" />
        </mxCell>
        <mxCell id="w5" value="&lt;b&gt;06 · GUÍA DE ENERGÍA&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;white-space:pre-wrap&quot;&gt;Conceptos y supuestos&#10;┌─────────────────┬───────────┐&#10;│ Potencia, tiempo│ Ejemplo   │&#10;│ Factor y límites│ interactivo│&#10;└─────────────────┴───────────┘&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FCFB;strokeColor=#168B82;fontColor=#243746;fontSize=13;spacing=8;" vertex="1" parent="1">
